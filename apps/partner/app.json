{
  "expo": {
    "name": "Last Call Partner",
    "slug": "lastcall-partner",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "lastcall-partner",
    "orientation": "portrait",
    "splash": { "backgroundColor": "#1d4ed8" },
    "android": {
      "package": "pk.lastcall.partner",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "pk.lastcall.partner",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker"
    ],
    "experiments": { "typedRoutes": true }
  }
}
