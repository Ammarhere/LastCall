# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Neon — free tier) ──────────────────────────────────────────────
# Local dev: postgresql://lastcall:lastcall_dev_pw@localhost:5432/lastcall
# Production: get from neon.tech dashboard
DATABASE_URL=postgresql://lastcall:lastcall_dev_pw@localhost:5432/lastcall

# ─── Redis (Upstash — free tier) ──────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: get from upstash.com dashboard (use REDIS_URL from Upstash)
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# ─── Firebase Admin ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ─── File Storage (Firebase Storage — free 5GB, no card needed) ───────────────
# Automatically uses: {FIREBASE_PROJECT_ID}.firebasestorage.app
# No extra configuration needed — derived from Firebase credentials above.
# Make sure Firebase Storage is enabled in Firebase Console → Build → Storage

# ─── Email (Resend — free 3,000/month) ────────────────────────────────────────
# Get from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@lastcall.pk

# ─── WhatsApp (Twilio) — DISABLED, add when ready ─────────────────────────────
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=+14155238886

# ─── Payment Gateways — add when merchant accounts are approved ───────────────
# JAZZCASH_MERCHANT_ID=your_merchant_id
# JAZZCASH_PASSWORD=your_password
# JAZZCASH_INTEGRITY_SALT=your_integrity_salt

# EASYPAISA_STORE_ID=your_store_id
# EASYPAISA_HASH_KEY=your_hash_key

# SADAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxx
# SADAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# NAYAPAY_API_KEY=your_nayapay_api_key
# NAYAPAY_WEBHOOK_SECRET=your_nayapay_webhook_secret

# ─── App URLs ─────────────────────────────────────────────────────────────────
# Production: your actual domain
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173
