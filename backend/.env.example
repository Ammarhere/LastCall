# ─── App ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lastcall:lastcall_dev_pw@localhost:5432/lastcall

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars_here
JWT_EXPIRES_IN=7d

# ─── Firebase Admin ──────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ─── AWS S3 / Cloudflare R2 (file uploads) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_BUCKET_NAME=lastcall-uploads
AWS_REGION=ap-south-1

# ─── Twilio (WhatsApp) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# ─── SendGrid (Email) ────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=hello@lastcall.pk

# ─── Payment Gateways ────────────────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_integrity_salt

EASYPAISA_STORE_ID=your_store_id
EASYPAISA_HASH_KEY=your_hash_key

SADAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxx
SADAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

NAYAPAY_API_KEY=your_nayapay_api_key
NAYAPAY_WEBHOOK_SECRET=your_nayapay_webhook_secret

RAAST_API_KEY=your_raast_api_key

# ─── App URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173
