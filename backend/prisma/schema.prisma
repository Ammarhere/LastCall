// This is the Prisma schema for Last Call — Pakistan's food waste rescue platform.
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BagStatus {
  DRAFT
  AVAILABLE
  SOLD_OUT
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  READY
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  SADAPAY
  NAYAPAY
  RAAST
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  CNIC
  BUSINESS_LICENSE
  BANK_STATEMENT
  UTILITY_BILL
}

enum NotifChannel {
  PUSH
  WHATSAPP
  EMAIL
  IN_APP
}

// ─── Core Tables ──────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  firebaseUid    String?   @unique @map("firebase_uid")
  phone          String    @unique
  name           String?
  email          String?
  role           UserRole  @default(CUSTOMER)
  passwordHash   String?   @map("password_hash")
  avatarUrl      String?   @map("avatar_url")
  fcmToken       String?   @map("fcm_token")
  referralCode   String    @unique @map("referral_code")
  referredById   String?   @map("referred_by_id")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  referredBy           User?                  @relation("Referrals", fields: [referredById], references: [id])
  referrals            User[]                 @relation("Referrals")
  partner              Partner?
  orders               Order[]
  reviews              Review[]
  favourites           Favourite[]
  savedPaymentMethods  SavedPaymentMethod[]
  notifications        Notification[]
  referralsMade        Referral[]             @relation("ReferrerRelation")
  referralReceived     Referral?              @relation("ReferredRelation")
  promotionUses        PromotionUse[]
  paymentTransactions  PaymentTransaction[]
  auditLogs            AuditLog[]

  @@map("users")
}

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  country   String   @default("PK")
  isActive  Boolean  @default(true) @map("is_active")
  latitude  Float?
  longitude Float?
  radiusKm  Float?   @map("radius_km")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  areas      Area[]
  partners   Partner[]
  bags       Bag[]
  promotions Promotion[]

  @@map("cities")
}

model Area {
  id       String  @id @default(uuid())
  cityId   String  @map("city_id")
  name     String
  slug     String
  isActive Boolean @default(true) @map("is_active")

  // Relations
  city     City      @relation(fields: [cityId], references: [id])
  bags     Bag[]

  @@unique([cityId, slug])
  @@map("areas")
}

model Partner {
  id                String        @id @default(uuid())
  userId            String        @unique @map("user_id")
  businessName      String        @map("business_name")
  slug              String        @unique
  category          String
  description       String?
  cityId            String        @map("city_id")
  area              String?
  address           String
  latitude          Float?
  longitude         Float?
  commissionPct     Float         @default(20) @map("commission_pct") /// must be 0–100, enforced in application layer
  status            PartnerStatus @default(PENDING)
  logoUrl           String?       @map("logo_url")
  coverUrl          String?       @map("cover_url")
  rating            Float         @default(0)
  reviewCount       Int           @default(0) @map("review_count")
  totalBagsListed   Int           @default(0) @map("total_bags_listed")
  totalBagsSold     Int           @default(0) @map("total_bags_sold")
  isFeatured        Boolean       @default(false) @map("is_featured")
  pickupInstructions String?      @map("pickup_instructions")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  user       User               @relation(fields: [userId], references: [id])
  city       City               @relation(fields: [cityId], references: [id])
  bags       Bag[]
  orders     Order[]
  documents  PartnerDocument[]
  reviews    Review[]
  payouts    Payout[]
  favourites Favourite[]
  bagTemplates BagTemplate[]

  @@index([cityId, status])
  @@map("partners")
}

model PartnerDocument {
  id           String       @id @default(uuid())
  partnerId    String       @map("partner_id")
  type         DocumentType
  fileUrl      String       @map("file_url")
  verifiedAt   DateTime?    @map("verified_at")
  verifiedById String?      @map("verified_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  partner    Partner @relation(fields: [partnerId], references: [id])

  @@map("partner_documents")
}

model Bag {
  id              String    @id @default(uuid())
  partnerId       String    @map("partner_id")
  cityId          String    @map("city_id")
  areaId          String?   @map("area_id")
  title           String
  description     String?
  originalPrice   Float     @map("original_price")
  discountedPrice Float     @map("discounted_price")
  quantityTotal   Int       @map("quantity_total")
  quantityLeft    Int       @map("quantity_left")
  pickupDate      DateTime  @map("pickup_date") @db.Date
  pickupStart     DateTime  @map("pickup_start") @db.Time
  pickupEnd       DateTime  @map("pickup_end") @db.Time
  status          BagStatus @default(DRAFT)
  photoUrl        String?   @map("photo_url")
  tags            String[]
  category        String?
  co2SavedKg      Float     @default(0) @map("co2_saved_kg")
  mealsSaved      Int       @default(0) @map("meals_saved")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  partner Partner @relation(fields: [partnerId], references: [id])
  city    City    @relation(fields: [cityId], references: [id])
  area    Area?   @relation(fields: [areaId], references: [id])
  orders  Order[]

  @@index([status, pickupDate])
  @@index([cityId, areaId, status])
  @@index([partnerId])
  @@map("bags")
}

model Order {
  id                String        @id @default(uuid())
  bagId             String        @map("bag_id")
  userId            String        @map("user_id")
  partnerId         String        @map("partner_id")
  quantity          Int           @default(1)
  unitPrice         Float         @map("unit_price")
  totalAmount       Float         @map("total_amount")
  commissionAmt     Float         @map("commission_amt")
  partnerPayoutAmt  Float         @map("partner_payout_amt")
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus       OrderStatus   @default(CONFIRMED) @map("order_status")
  pickupCode        String        @unique @map("pickup_code")
  pickedUpAt        DateTime?     @map("picked_up_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelReason      String?       @map("cancel_reason")
  refundInitiatedAt DateTime?     @map("refund_initiated_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  bag                 Bag                  @relation(fields: [bagId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  partner             Partner              @relation(fields: [partnerId], references: [id])
  review              Review?
  paymentTransactions PaymentTransaction[]
  promotionUse        PromotionUse?

  @@index([userId, createdAt])
  @@index([partnerId, createdAt])
  @@index([orderStatus])
  @@map("orders")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  orderId         String?       @map("order_id")
  userId          String        @map("user_id")
  method          PaymentMethod
  txnRef          String        @unique @map("txn_ref")
  gatewayRef      String?       @map("gateway_ref")
  amount          Float
  currency        String        @default("PKR")
  status          PaymentStatus @default(PENDING)
  gatewayPayload  Json?         @map("gateway_payload")
  callbackPayload Json?         @map("callback_payload")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payment_transactions")
}

model SavedPaymentMethod {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  method            PaymentMethod
  label             String
  maskedIdentifier  String?       @map("masked_identifier")
  isDefault         Boolean       @default(false) @map("is_default")
  createdAt         DateTime      @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("saved_payment_methods")
}

model Review {
  id                String    @id @default(uuid())
  orderId           String    @unique @map("order_id")
  userId            String    @map("user_id")
  partnerId         String    @map("partner_id")
  rating            Int
  comment           String?
  isVisible         Boolean   @default(true) @map("is_visible")
  partnerReply      String?   @map("partner_reply")
  partnerRepliedAt  DateTime? @map("partner_replied_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@map("reviews")
}

model Favourite {
  userId    String   @map("user_id")
  partnerId String   @map("partner_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])

  @@id([userId, partnerId])
  @@map("favourites")
}

model Payout {
  id                 String       @id @default(uuid())
  partnerId          String       @map("partner_id")
  periodStart        DateTime     @map("period_start")
  periodEnd          DateTime     @map("period_end")
  orderCount         Int          @map("order_count")
  grossAmount        Float        @map("gross_amount")
  commissionDeducted Float        @map("commission_deducted")
  netAmount          Float        @map("net_amount")
  status             PayoutStatus @default(PENDING)
  method             PaymentMethod?
  txnRef             String?      @map("txn_ref")
  processedAt        DateTime?    @map("processed_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  // Relations
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, periodStart])
  @@map("payouts")
}

model Referral {
  id                String    @id @default(uuid())
  referrerId        String    @map("referrer_id")
  referredId        String    @unique @map("referred_id")
  discountAppliedAt DateTime? @map("discount_applied_at")
  rewardIssuedAt    DateTime? @map("reward_issued_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  referrer User @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referred User @relation("ReferredRelation", fields: [referredId], references: [id])

  @@map("referrals")
}

model Promotion {
  id            String    @id @default(uuid())
  code          String?   @unique
  title         String
  description   String?
  discountPct   Float?    @map("discount_pct")
  discountFlat  Float?    @map("discount_flat")
  minOrderAmt   Float?    @map("min_order_amt")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  validFrom     DateTime  @map("valid_from")
  validUntil    DateTime  @map("valid_until")
  cityId        String?   @map("city_id")
  isActive      Boolean   @default(true) @map("is_active")
  bannerUrl     String?   @map("banner_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  city  City?          @relation(fields: [cityId], references: [id])
  uses  PromotionUse[]

  @@map("promotions")
}

model PromotionUse {
  id          String   @id @default(uuid())
  promotionId String   @map("promotion_id")
  userId      String   @map("user_id")
  orderId     String?  @unique @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  promotion Promotion @relation(fields: [promotionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  order     Order?    @relation(fields: [orderId], references: [id])

  @@map("promotion_uses")
}

model Notification {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  title     String
  body      String
  channel   NotifChannel
  isRead    Boolean      @default(false) @map("is_read")
  payload   Json?
  createdAt DateTime     @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model ImpactStat {
  id               String   @id @default(uuid())
  date             DateTime @unique @db.Date
  bagsSaved        Int      @default(0) @map("bags_saved")
  mealsSaved       Int      @default(0) @map("meals_saved")
  co2SavedKg       Float    @default(0) @map("co2_saved_kg")
  waterSavedLiters Float    @default(0) @map("water_saved_liters")
  partnerCount     Int      @default(0) @map("partner_count")
  customerCount    Int      @default(0) @map("customer_count")

  @@map("impact_stats")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

// ─── Bag Templates (Recurring Bags) ──────────────────────────────────────────

model BagTemplate {
  id              String   @id @default(uuid())
  partnerId       String   @map("partner_id")
  title           String
  description     String?
  originalPrice   Float    @map("original_price")
  discountedPrice Float    @map("discounted_price")
  quantityTotal   Int      @map("quantity_total")
  pickupStart     String   @map("pickup_start")   /// "HH:MM" e.g. "18:00"
  pickupEnd       String   @map("pickup_end")     /// "HH:MM" e.g. "21:00"
  activeDays      String[] @map("active_days")    /// ["MON","TUE","WED","THU","FRI","SAT","SUN"]
  isActive        Boolean  @default(true) @map("is_active")
  photoUrl        String?  @map("photo_url")
  tags            String[]
  category        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, isActive])
  @@map("bag_templates")
}
